// Copy to include/secrets.h and fill in. secrets.h is gitignored — this repository is
// destined to be public, see RULE 0 in CLAUDE.md. Never commit real values.
//
// The ESP8266 is 2.4 GHz only: WIFI_SSID must be a 2.4 GHz network.

#pragma once

#define WIFI_SSID       "your-2.4GHz-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

#define MQTT_HOST       "192.0.2.10"      // your broker
#define MQTT_PORT       1883
#define MQTT_USER       "your-mqtt-user"  // a login dedicated to this device
#define MQTT_PASSWORD   "your-mqtt-password"
#define MQTT_PREFIX     "pool-lights/"    // keep to your own topic tree on a shared broker

// OTA, from the OTA rung onward
#define OTA_PASSWORD    "your-ota-password"
